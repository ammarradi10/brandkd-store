{% comment %}
================================================================================
  WHY THERMAWRAP — "8 Gründe" Landingpage
  Eigenständige Section, Marketing-Winkel: Nighttime Pain Relief
  Bildquelle je Grund: Theme-Editor Bild-Upload (Block-Einstellung) mit
  automatischem Icon-Fallback, falls kein Bild gesetzt ist.
================================================================================
{% endcomment %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@500;700;800;900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap');

.wt{
  --accent:#DC2626;
  --accent-deep:#7C1D1D;
  --accent-soft:rgba(220,38,38,0.10);
  --green:#16a34a;
  --green-soft:rgba(22,163,74,0.10);
  --bg:#FFFFFF;
  --bg-soft:#F5F5F5;
  --ink:#111111;
  --tx:#1A1A1A;
  --tx-dim:#6B7280;
  --card:#FAFAFA;
  --card-line:#E5E5E5;
  --display:'Anton',Impact,sans-serif;
  --head:'Manrope',sans-serif;
  --sans:'Inter',-apple-system,sans-serif;
  --mono:'JetBrains Mono',monospace;

  font-family:var(--sans);
  color:var(--ink);
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  line-height:1.55;
  width:100vw;max-width:100vw;
  margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);
}
.wt *,.wt *::before,.wt *::after{box-sizing:border-box}
.wt img{max-width:100%;height:auto;display:block}

/* Hero */
.wt-hero{padding:88px 24px 64px;text-align:center}
.wt-eyebrow{display:inline-block;font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;padding:6px 13px;border-radius:100px;background:var(--accent-soft);color:var(--accent);border:1px solid rgba(220,38,38,0.25);margin-bottom:18px}
.wt-h1{font-family:var(--display);font-weight:400;line-height:1.05;letter-spacing:0.005em;text-transform:uppercase;color:var(--ink);font-size:48px;max-width:800px;margin:0 auto 20px}
.wt-h1 em{color:var(--accent);font-style:normal}
.wt-sub{font-size:16px;color:var(--tx);line-height:1.6;max-width:560px;margin:0 auto}

/* Editorial list */
.wt-list{max-width:1080px;margin:0 auto;padding:24px 24px 96px;display:flex;flex-direction:column;gap:0}
.wt-row{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;padding:56px 0;border-bottom:1px solid var(--card-line)}
.wt-row:first-child{padding-top:24px}
.wt-row:last-child{border-bottom:none}
.wt-row.is-reverse{direction:rtl}
.wt-row.is-reverse > *{direction:ltr}

.wt-frame{position:relative;aspect-ratio:4/3;border-radius:18px;overflow:hidden;background:var(--card);border:1px solid var(--card-line);display:flex;align-items:center;justify-content:center}
.wt-frame img{width:100%;height:100%;object-fit:cover}
.wt-frame-icon{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--accent-soft),var(--bg-soft))}
.wt-frame-icon svg{width:64px;height:64px;color:var(--accent);stroke-width:1.6}

.wt-copy{max-width:440px}
.wt-num{font-family:var(--mono);font-weight:700;font-size:13px;letter-spacing:0.14em;color:var(--accent);margin-bottom:14px;display:block}
.wt-heading{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:28px;line-height:1.15;letter-spacing:0.005em;color:var(--ink);margin:0 0 14px}
.wt-text{font-size:15px;color:var(--tx);line-height:1.65;margin:0}

/* Closing CTA */
.wt-cta-sec{background:var(--bg-soft);border-top:1px solid var(--card-line);padding:72px 24px;text-align:center}
.wt-cta-h{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:34px;line-height:1.1;color:var(--ink);max-width:600px;margin:0 auto 28px}
.wt-cta-h em{color:var(--accent);font-style:normal}
.wt-cta{display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#fff;text-decoration:none;padding:16px 32px;border-radius:100px;font-family:var(--head);font-weight:800;font-size:15px;letter-spacing:0.06em;text-transform:uppercase;box-shadow:0 12px 32px -12px rgba(220,38,38,0.45);transition:transform .15s ease,background .15s ease}
.wt-cta:hover{transform:translateY(-2px);background:var(--accent-deep)}
.wt-cta::after{content:"\2192";font-size:18px}

@media(max-width:860px){
  .wt-hero{padding:64px 20px 44px}
  .wt-h1{font-size:34px}
  .wt-row{grid-template-columns:1fr;gap:24px;padding:40px 0}
  .wt-row.is-reverse{direction:ltr}
  .wt-copy{max-width:100%}
  .wt-heading{font-size:24px}
  .wt-cta-h{font-size:26px}
}
</style>

<div class="wt">

  <section class="wt-hero">
    {% if section.settings.eyebrow != blank %}
      <span class="wt-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="wt-h1">{{ section.settings.heading }}</h1>
    {% if section.settings.subheading != blank %}
      <p class="wt-sub">{{ section.settings.subheading }}</p>
    {% endif %}
  </section>

  <section class="wt-list">
    {% for block in section.blocks %}
      {% assign is_even = forloop.index | modulo: 2 %}
      <div class="wt-row{% if is_even == 0 %} is-reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="wt-frame">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
          {% else %}
            <div class="wt-frame-icon">
              {% case block.type %}
                {% when 'reason_1' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20 15.5A8.5 8.5 0 1 1 8.5 4a7 7 0 0 0 11.5 11.5z"/></svg>
                {% when 'reason_2' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h6a4 4 0 0 1 4 4v1"/><path d="M7 17h6a4 4 0 0 0 4-4"/><line x1="3" y1="3" x2="21" y2="21"/></svg>
                {% when 'reason_3' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M3 12h3M18 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/><circle cx="12" cy="12" r="4"/></svg>
                {% when 'reason_4' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                {% when 'reason_5' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12V6a2 2 0 1 1 4 0v5M12 11V5a2 2 0 1 1 4 0v6M16 12V7a2 2 0 1 1 4 0v7c0 4-3 7-7 7h-1c-3 0-4.5-1-6-3l-3-4.5c-.6-1 .2-2.2 1.3-1.9 1 .3 1.9 1 2.7 1.9"/></svg>
                {% when 'reason_6' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12V6a2 2 0 1 1 4 0v5M12 11V5a2 2 0 1 1 4 0v6M16 12V7a2 2 0 1 1 4 0v7c0 4-3 7-7 7h-1c-3 0-4.5-1-6-3l-3-4.5c-.6-1 .2-2.2 1.3-1.9 1 .3 1.9 1 2.7 1.9"/><path d="M3 3l1.5 1.5M3 7h2M4.5 10.5 3 12"/></svg>
                {% when 'reason_7' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="8.5" cy="9" r="3.2"/><circle cx="15.5" cy="9" r="3.2"/><path d="M2.5 19c.6-3 2.8-5 6-5s5.4 2 6 5M9.5 19c.6-3 2.8-5 6-5s5.4 2 6 5"/></svg>
                {% when 'reason_8' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="14" r="4.5"/><path d="M12 3v2.5M4.5 8 6.3 9.6M19.5 8l-1.8 1.6M2 19h20"/></svg>
              {% endcase %}
            </div>
          {% endif %}
        </div>
        <div class="wt-copy">
          <span class="wt-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }} / 08</span>
          <h2 class="wt-heading">{{ block.settings.heading }}</h2>
          <p class="wt-text">{{ block.settings.text }}</p>
        </div>
      </div>
    {% endfor %}
  </section>

  <section class="wt-cta-sec">
    <h2 class="wt-cta-h">{{ section.settings.cta_heading }}</h2>
    <a href="{{ section.settings.cta_url }}" class="wt-cta">{{ section.settings.cta_label }}</a>
  </section>

</div>

{% schema %}
{
  "name": "Warum ThermaWrap",
  "tag": "section",
  "class": "why-thermawrap-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow-Text",
      "default": "Warum ThermaWrap"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "8 Gründe, warum 3 Uhr nachts bald der Vergangenheit angehört."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Unterüberschrift",
      "default": "Taube Finger, brennende Handgelenke, hellwach im Dunkeln — das kennst du. Hier sind acht Gründe, warum ThermaWrap genau dafür gebaut wurde."
    },
    {
      "type": "header",
      "content": "Abschluss-CTA"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA-Überschrift",
      "default": "Bereit für ruhigere Nächte?"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA-Link",
      "default": "/products/thermawrap-starter"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button-Text",
      "default": "ThermaWrap entdecken"
    }
  ],
  "blocks": [
    {
      "type": "reason_1",
      "name": "Grund 1",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "3 Uhr nachts ist dein schlimmster Feind" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Taubheit und Brennen werden nachts am stärksten – genau dann, wenn du am wenigsten dagegen tun kannst. ThermaWrap liegt griffbereit neben deinem Bett, für genau diesen Moment." }
      ]
    },
    {
      "type": "reason_2",
      "name": "Grund 2",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "Kein Kabel, das sich nachts verheddert" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Die Fernbedienung ist komplett kabellos. Du kannst dich im Schlaf drehen, ohne dass ein Kabel sich um dein Handgelenk wickelt oder herausrutscht." }
      ]
    },
    {
      "type": "reason_3",
      "name": "Grund 3",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "Wärme, Licht und Vibration – gemeinsam statt einzeln" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "660nm & 850nm Rotlicht, 3 Wärmestufen bis 70°C und sanfte Vibration wirken gleichzeitig, statt dass du mehrere einzelne Produkte kombinieren musst." }
      ]
    },
    {
      "type": "reason_4",
      "name": "Grund 4",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "Kein Wachliegen, bis der Schmerz von selbst nachlässt" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "20 Minuten, bevor du das Licht ausmachst – statt stundenlang zu warten, bis Taubheit und Ziehen von selbst abklingen." }
      ]
    },
    {
      "type": "reason_5",
      "name": "Grund 5",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "Dein Handgelenk sollte nicht bis zum Morgen warten" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Die Wärme setzt sofort ein. Du musst nicht bis zum nächsten Arzttermin oder bis zum Morgen warten, um etwas zu spüren." }
      ]
    },
    {
      "type": "reason_6",
      "name": "Grund 6",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "Kein Aufwachen mehr mit tauben Fingern" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Nachts kurz aufstehen und die Hand erst wieder \"wachschütteln\" müssen, bevor sie sich normal anfühlt? Genau das soll seltener werden." }
      ]
    },
    {
      "type": "reason_7",
      "name": "Grund 7",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "Weil auch dein Partner schlafen will" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Leise Vibration, kein grelles Dauerlicht im Zimmer. Du kümmerst dich um dein Handgelenk, ohne die Nacht für alle anderen mitzustören." }
      ]
    },
    {
      "type": "reason_8",
      "name": "Grund 8",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "Morgens wieder richtig funktionieren" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Ein Glas öffnen, die Kaffeetasse halten, dich anziehen – ohne dass die erste halbe Stunde des Tages vom eigenen Handgelenk bestimmt wird." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Warum ThermaWrap",
      "blocks": [
        { "type": "reason_1" },
        { "type": "reason_2" },
        { "type": "reason_3" },
        { "type": "reason_4" },
        { "type": "reason_5" },
        { "type": "reason_6" },
        { "type": "reason_7" },
        { "type": "reason_8" }
      ]
    }
  ]
}
{% endschema %}
