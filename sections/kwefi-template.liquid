</div>

<script>(function(){
'use strict';

/* ====== EDIT YOUR PRODUCT DATA HERE ====== */
var PLANS = {
  '1': { url:'/cart/55912939716993:1', productId:'15454753849729', variantId:'55912939716993', name:'ThermaWrap Single', price:'89,99€', strike:'129,00€', perUnit:'100,00 € / Stück', bill:'Ab zweitem Stück 25%', total:'89,99€', totalStrike:'129,00€', stickyPrice:'89,99€', label:'Vorbestellung Angebot 1' },
  '2': { url:'/cart/55912947908993:1', productId:'15454755651969', variantId:'55912947908993', name:'ThermaWrap Duo', price:'139,99€', strike:'258,00€', perUnit:'100,00 € / Stück', bill:'Kaufe 2, erhalte die 3. gratis',     total:'139,99€', totalStrike:'258,00€', stickyPrice:'139,99€', label:'Vorbestellung Angebot 2' }
};

/* Gift content shown in the explainer modal */
var GIFT_DATA = {
  '0': { tag:'<span class="strike">20€</span>Kostenlos', img:'https://img.freepik.com/premium-vector/free-shipping-truck-icon-smooth-ecommerce-delivery-experience_1310542-1594.jpg', title:'Kostenloser Versand', sub:'Wir übernehmen die Versandkosten – für dich völlig kostenlos.',
    sections:[{ type:'feats', items:['Schnelle Lieferung','Keine versteckten Kosten','Versand in die gesamte EU'] }] },
  '1': { tag:'<span class="strike">10,00€</span>GRATIS', img:'https://cdn.shopify.com/s/files/1/0940/9799/8209/files/2026-06-07220732_26082e0e-5081-40b2-8776-64d8f424348c.png?v=1783724653', productId:'15453518430593', variantId:'55902524473729', title:'USB Ladegerät', sub:'Damit dein ThermaWrap immer einsatzbereit ist – im Wert von 10€, für dich gratis.',
    sections:[{ h:"Das ist enthalten", type:'rows', items:[
      { name:'Ladekabel', desc:'Passendes USB-Kabel für dein ThermaWrap – einfach anschließen, fertig.' },
      { name:'Ladezeit', desc:'Vollständig aufgeladen in nur 3 Stunden.' },
      { name:'Kompatibilität', desc:'Passt exakt auf den ThermaWrap-Anschluss – kein Adapter nötig.' }
    ]}], foot:'Automatisch im Warenkorb enthalten – bei jeder Bestellung.' },
  '2': { tag:'<span class="strike">10,00€</span>GRATIS', img:'https://cdn.shopify.com/s/files/1/0940/9799/8209/files/2026-06-07220619_a655e656-38ad-444d-90f3-3338e6f55e3b.png?v=1783725453', productId:'15453518659969', variantId:'55902525620609', title:'Soft Hand Mask', sub:'Für weiche, gepflegte Hände nach jeder Anwendung – im Wert von 10€, für dich gratis.',
    sections:[{ type:'feats', items:['Intensive Feuchtigkeitspflege','Für alle Hauttypen','Schnell einziehend','Mit pflegenden Inhaltsstoffen'] }], foot:'Wird automatisch mit deiner Bestellung mitgeliefert.' },
  '3': { tag:'<span class="strike">12,00€</span>GRATIS', img:'https://cdn.shopify.com/s/files/1/0940/9799/8209/files/2026-06-07220600_589acf91-d7c3-494f-8aa3-a72045a82931.png?v=1783725421', productId:'15453518758273', variantId:'55902525882753', title:'Milch-Honig Handpflege Wachs', sub:'Entfernt sanft abgestorbene Hautzellen für weiche Hände – im Wert von 12€, für dich gratis.',
    sections:[{ h:'Anwendung', type:'feats', items:['Auf die Hände auftragen, ca. 10 Minuten einwirken lassen, dann sanft einmassieren und mit Wasser abspülen.'] },
    { h:'Inhaltsstoffe', type:'rows', items:[
      { name:'Honig-Extrakt', desc:'Spendet Feuchtigkeit und beruhigt die Haut.' },
      { name:'Milch-Extrakt', desc:'Enthält milde Milchsäure – sanfte Peeling-Wirkung für weiche Haut.' }
    ]}], foot:'Wird automatisch mit deiner Bestellung mitgeliefert.' }
};

/* Plan-dependent info-pill text */
function infoQtyText(plan){ return plan === '2' ? '[Qty for Offer 2 — bundle]' : '[Qty for Offer 1 — single]'; }

/* Bonus gift unlock rules. Offer 1 unlocks first 2 gifts; Offer 2 unlocks all four. */
var GIFT_VALUES = [20, 10, 10, 12];
var MAX_VALUE = 52;
function isUnlocked(i, plan){
  if(i === 0) return true;
  if(i === 1) return true;
  return plan === '2';
}
function unlockMessage(i, plan){
  if(plan !== '2' && (i === 2 || i === 3)) return 'Zu Angebot 2 upgraden';
  return '';
}

/* ====================== ENGINE (no need to edit below) ====================== */
var selectedPlan = '1', wasMaxed = false;

var cards = document.querySelectorAll('.kw-card[data-plan]');
var gifts = document.querySelectorAll('.kw-gift');
var cta = document.getElementById('kwCta');
var ctaLabel = document.getElementById('kwCtaLabel');
var ctaPrice = document.getElementById('kwCtaPrice');
var ctaStrike = document.getElementById('kwCtaStrike');
var claim = document.getElementById('kwClaim');
var stickyCta = document.getElementById('kwStickyCta');
var stickyPrice = document.getElementById('kwStickyPrice');
var stickyName = document.getElementById('kwStickyName');
var toast = document.getElementById('kwToast');

/* Confetti */
var canvas = document.getElementById('kwConfetti');
var ctx = canvas.getContext('2d');
var pieces = [], running = false;
function sizeCanvas(){ canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
sizeCanvas(); window.addEventListener('resize', sizeCanvas);
function fireConfetti(){
  var colors = ['#ea580c','#fb923c','#16a34a','#f59e0b','#dc2626','#111827'];
  var cx = canvas.width/2, cy = canvas.height/3;
  for(var i=0;i<140;i++){
    var a = Math.random()*Math.PI*2, sp = 6+Math.random()*8;
    pieces.push({ x:cx+(Math.random()-0.5)*200, y:cy, vx:Math.cos(a)*sp*(0.5+Math.random()), vy:Math.sin(a)*sp-4, g:0.18+Math.random()*0.08, sz:6+Math.random()*6, c:colors[Math.floor(Math.random()*colors.length)], rot:Math.random()*Math.PI, vr:(Math.random()-0.5)*0.3, life:1 });
  }
  if(!running){ running=true; animate(); }
}
function animate(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  pieces = pieces.filter(function(p){ return p.life>0 && p.y<canvas.height+40; });
  pieces.forEach(function(p){ p.vy+=p.g; p.x+=p.vx; p.y+=p.vy; p.rot+=p.vr; p.life-=0.005; ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.rot); ctx.fillStyle=p.c; ctx.globalAlpha=Math.max(0,p.life); ctx.fillRect(-p.sz/2,-p.sz/4,p.sz,p.sz/2); ctx.restore(); });
  if(pieces.length>0) requestAnimationFrame(animate); else running=false;
}
var SESSION_KEY='kwCelebrated', celebrated=false, toastTimer;
try { celebrated = sessionStorage.getItem(SESSION_KEY)==='1'; } catch(e){}
function celebrate(){
  if(celebrated) return;
  celebrated=true;
  try { sessionStorage.setItem(SESSION_KEY,'1'); } catch(e){}
  fireConfetti();
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){ toast.classList.remove('show'); }, 2800);
}
toast.addEventListener('click', function(){ toast.classList.remove('show'); });

function render(){
  var p = PLANS[selectedPlan];

  cards.forEach(function(c){ c.classList.toggle('is-selected', c.dataset.plan === selectedPlan); });

  ['1','2'].forEach(function(d){
    var pp = PLANS[d];
    document.querySelector('[data-price-'+d+']').textContent = pp.price;
    document.querySelector('[data-strike-'+d+']').textContent = pp.strike;
    var perUnitEl = document.querySelector('[data-perunit-'+d+']');
    if(perUnitEl) perUnitEl.textContent = pp.perUnit;
    var billEl = document.querySelector('[data-bill-'+d+']');
    if(billEl) billEl.textContent = pp.bill;
  });

  // Info pill (qty)
  var qtyTxt = document.querySelector('#kwInfoQty .kw-info-qty-text');
  if(qtyTxt) qtyTxt.textContent = infoQtyText(selectedPlan);

  // Gifts
  var claimedValue = 0;
  gifts.forEach(function(g, i){
    var open = isUnlocked(i, selectedPlan);
    g.classList.toggle('is-locked', !open);
    if(open) claimedValue += GIFT_VALUES[i] || 0;
    var msgEl = g.querySelector('.kw-gift-unlock-msg');
    if(msgEl) msgEl.textContent = open ? '' : unlockMessage(i, selectedPlan);
  });

  var upgradeValue = MAX_VALUE - claimedValue;
  var isMaxed = upgradeValue <= 0;
  if(!isMaxed){
    claim.innerHTML = 'Eingelöst: <span class="val">'+claimedValue.toFixed(2).replace('.',',')+'€</span> &middot; noch <strong>'+upgradeValue.toFixed(2).replace('.',',')+'€</strong> mehr mit <span class="kw-upgrade-link" id="kwUpgradeLink">ANGEBOT 2 &rarr;</span>';
    var link = document.getElementById('kwUpgradeLink');
    if(link) link.addEventListener('click', function(){ selectedPlan='2'; render(); });
  } else {
    claim.innerHTML = '&#127881; Alle Boni freigeschaltet &mdash; <span class="val">'+claimedValue.toFixed(2).replace('.',',')+'€</span> eingelöst.';
  }

  ctaLabel.textContent = p.label;
  ctaPrice.textContent = p.total;
  ctaStrike.textContent = p.totalStrike;
  cta.href = p.url;


  stickyCta.href = p.url;
  stickyPrice.textContent = p.stickyPrice;
  stickyName.textContent  = p.name;

  // Confetti opens when Offer 2 is selected (best AOV)
  if(selectedPlan === '2' && isMaxed && !wasMaxed) celebrate();
  wasMaxed = isMaxed;
}

cards.forEach(function(c){
  c.addEventListener('click', function(){ selectedPlan = c.dataset.plan; render(); });
});

render();

/* Gallery thumbs */
var stage = document.getElementById('kwStage');
var stageTag = document.getElementById('kwStageTag');
document.querySelectorAll('.kw-thumb').forEach(function(t){
  t.addEventListener('click', function(){
    document.querySelectorAll('.kw-thumb').forEach(function(x){ x.classList.remove('is-active'); });
    t.classList.add('is-active');
    if(stage) stage.src = t.dataset.img;
    if(stageTag){ stageTag.textContent = t.dataset.tag; stageTag.style.color = t.dataset.tagColor || ''; }
  });
});

/* Dynamic arrival date — today + 15 days */
(function(){
  var el = document.getElementById('kwShipDate'); if(!el) return;
  var d = new Date(); d.setDate(d.getDate() + 15);
  var months = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
  el.textContent = d.getDate() + '. ' + months[d.getMonth()];
})();

/* Neukunden-Rabatt Countdown — zählt nur echte, im Section-Setting hinterlegte Daten herunter */
(function(){
  var el = document.querySelector('[data-promo-timer]'); if(!el) return;
  var wrap = el.closest('[data-promo-ends]');
  var endsAt = wrap && wrap.getAttribute('data-promo-ends');
  if(!endsAt) return;
  var end = new Date(endsAt).getTime();
  if(isNaN(end)){ el.remove(); return; }
  function pad(n){ return String(n).padStart(2,'0'); }
  var timer = setInterval(tick, 1000);
  function tick(){
    var diff = end - Date.now();
    if(diff <= 0){ if(wrap) wrap.remove(); clearInterval(timer); return; }
    var h = Math.floor(diff/3600000), m = Math.floor((diff%3600000)/60000), s = Math.floor((diff%60000)/1000);
    el.textContent = 'Noch ' + pad(h) + ':' + pad(m) + ':' + pad(s);
  }
  tick();
})();

/* Country flag from visitor IP */
(function(){
  var el = document.getElementById('kwFlag'); if(!el) return;
  function flagEmoji(cc){
    if(!cc || cc.length !== 2) return '';
    var A = 0x1F1E6, base = 'A'.charCodeAt(0);
    cc = cc.toUpperCase();
    return String.fromCodePoint(A + cc.charCodeAt(0) - base) +
           String.fromCodePoint(A + cc.charCodeAt(1) - base);
  }
  fetch('https://ipwho.is/?fields=country_code')
    .then(function(r){ return r.json(); })
    .then(function(d){ if(d && d.country_code) el.textContent = flagEmoji(d.country_code); })
    .catch(function(){});
})();

/* Trust marquee duplication */
var track = document.querySelector('.kw-trust-track');
if(track){ track.innerHTML += track.innerHTML; }

/* FAQ (one open at a time) */
var faqs = document.querySelectorAll('.kw-faq-item');
faqs.forEach(function(it){ it.addEventListener('toggle', function(){ if(it.open) faqs.forEach(function(o){ if(o!==it) o.open=false; }); }); });

/* Detail slider — auto-scroll */
var sliders = [].slice.call(document.querySelectorAll('.kw-islider'));
sliders.forEach(function(s){
  s.innerHTML += s.innerHTML; s._p = false; s._h = 0;
  ['pointerdown','touchstart','wheel','mousedown'].forEach(function(ev){
    s.addEventListener(ev, function(){ s._p = true; clearTimeout(s._t); s._t = setTimeout(function(){ s._p = false; }, 1800); }, { passive:true });
  });
});
window.addEventListener('resize', function(){ sliders.forEach(function(s){ s._h = 0; }); });
(function loop(){
  sliders.forEach(function(s){
    if(s.offsetParent === null) return;
    if(!s._h) s._h = s.scrollWidth/2;
    if(!s._p){ s.scrollLeft += 0.5; if(s._h && s.scrollLeft >= s._h) s.scrollLeft -= s._h; }
  });
  requestAnimationFrame(loop);
})();

/* Rating row → scroll to studies */
var ratingEl = document.getElementById('kwRating');
var studies = document.getElementById('kwTested');
if(ratingEl && studies){
  ratingEl.setAttribute('role','button');
  ratingEl.setAttribute('tabindex','0');
  var goStudies = function(){ studies.scrollIntoView({ behavior:'smooth', block:'start' }); };
  ratingEl.addEventListener('click', goStudies);
  ratingEl.addEventListener('keydown', function(e){ if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); goStudies(); } });
}

/* Gift explainer modal */
(function(){
  var modal = document.getElementById('kwGiftModal'); if(!modal) return;
  var img = document.getElementById('kwGiftModalImg');
  var imgWrap = modal.querySelector('.kw-giftmodal-img');
  var title = document.getElementById('kwGiftModalTitle');
  var tag = document.getElementById('kwGiftModalTag');
  var sub = document.getElementById('kwGiftModalSub');
  var body = document.getElementById('kwGiftModalBody');
  var closeBtn = document.getElementById('kwGiftModalClose');
  var lastFocus = null;

  function renderBody(data){
    var html = '';
    (data.sections || []).forEach(function(s){
      html += '<div class="kw-giftmodal-section">';
      if(s.h) html += '<div class="kw-giftmodal-h">' + s.h + '</div>';
      if(s.type === 'feats'){
        html += '<ul class="kw-giftmodal-feats">';
        s.items.forEach(function(it){ html += '<li>' + it + '</li>'; });
        html += '</ul>';
      } else if(s.type === 'rows'){
        s.items.forEach(function(r){
          var noDose = r.dose ? '' : ' no-dose';
          html += '<div class="kw-giftmodal-row' + noDose + '"><div class="name">' + r.name + (r.desc ? '<small>' + r.desc + '</small>' : '') + '</div>';
          if(r.dose) html += '<div class="dose">' + r.dose + '</div>';
          html += '</div>';
        });
      }
      html += '</div>';
    });
    if(data.foot){
      html += '<div class="kw-giftmodal-foot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>' + data.foot + '</div>';
    }
    body.innerHTML = html;
  }

  function open(k){
    var d = GIFT_DATA[k]; if(!d) return;
    tag.innerHTML = d.tag || 'FREE BONUS';
    title.innerHTML = d.title;
    sub.innerHTML = d.sub;
    if(d.img){ img.src = d.img; img.alt = title.textContent; imgWrap.style.display = ''; } else { imgWrap.style.display = 'none'; }
    renderBody(d);
    lastFocus = document.activeElement;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
    setTimeout(function(){ closeBtn.focus(); }, 60);
  }
  function close(){
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden','true');
    document.body.style.overflow = '';
    if(lastFocus && lastFocus.focus) lastFocus.focus();
  }

  document.querySelectorAll('.kw-gift[data-gift]').forEach(function(g){
    g.addEventListener('click', function(){ open(g.dataset.gift); });
    g.setAttribute('role','button');
    g.setAttribute('tabindex','0');
    g.addEventListener('keydown', function(e){ if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); open(g.dataset.gift); } });
  });

  closeBtn.addEventListener('click', close);
  modal.addEventListener('click', function(e){ if(e.target === modal) close(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && modal.classList.contains('is-open')) close(); });
})();

/* Study image lightbox */
(function(){
  var lb = document.getElementById('kwLightbox'); if(!lb) return;
  var lbImg = document.getElementById('kwLightboxImg');
  var closeBtn = document.getElementById('kwLightboxClose');
  function open(src, alt){
    lbImg.style.width = '';
    lbImg.src = src; lbImg.alt = alt || '';
    lb.classList.add('is-open');
    lb.setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
    lbImg.onload = function(){
      /* Cap the display size at the image's own natural pixel dimensions,
         so it is only ever scaled down to fit the screen, never scaled up. */
      lbImg.style.width = lbImg.naturalWidth + 'px';
    };
  }
  function close(){
    lb.classList.remove('is-open');
    lb.setAttribute('aria-hidden','true');
    document.body.style.overflow = '';
  }
  document.querySelectorAll('.kw-tested-img').forEach(function(btn){
    btn.addEventListener('click', function(){
      var img = btn.querySelector('img');
      open(btn.dataset.lightboxSrc || (img && img.src), img && img.alt);
    });
  });
  closeBtn.addEventListener('click', close);
  lb.addEventListener('click', function(e){ if(e.target === lb) close(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && lb.classList.contains('is-open')) close(); });
})();

/* Explicit fallback for the study source links (belt-and-suspenders
   in case anything else on the page intercepts default anchor clicks) */
(function(){
  document.querySelectorAll('.kw-ing-study a[href]').forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault();
      window.open(a.href, '_blank', 'noopener,noreferrer');
    });
  });
})();

})();

function kwPlayVid(wrap){
  var v = wrap.querySelector('video'); if(!v) return;
  if(wrap.classList.contains('playing')){ v.pause(); wrap.classList.remove('playing'); return; }
  document.querySelectorAll('.kw-vid-frame.playing').forEach(function(w){ var ov = w.querySelector('video'); if(ov){ ov.pause(); } w.classList.remove('playing'); });
  wrap.classList.add('playing');
  v.play().catch(function(){ wrap.classList.remove('playing'); });
  v.onended = function(){ wrap.classList.remove('playing'); };
}
</script>
