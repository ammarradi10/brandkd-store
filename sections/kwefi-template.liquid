.kw-giftmodal-tag .strike{text-decoration:line-through;opacity:0.7;margin-right:5px}
.kw-giftmodal-img{width:140px;height:140px;margin:0 auto 14px;border-radius:16px;background:var(--card);border:1px solid var(--card-line);display:flex;align-items:center;justify-content:center;overflow:hidden}
.kw-giftmodal-img img{width:100%;height:100%;object-fit:contain}
.kw-giftmodal-title{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:30px;line-height:1.05;color:var(--ink);letter-spacing:0.01em;margin:0 0 8px}
