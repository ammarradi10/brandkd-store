.kw-meal-stat{display:flex;flex-direction:column;gap:10px}
.kw-meal-num{font-family:'Playfair Display',Georgia,serif;font-size:48px;line-height:1;font-weight:500;color:#fff;letter-spacing:-0.02em}
.kw-meal-lbl{font-family:var(--sans);font-size:14px;line-height:1.35;color:#cfd0d2;font-weight:400}
.kw-meal-cta{display:inline-flex;align-self:flex-start;background:#fff;color:#111;text-decoration:none;padding:14px 28px;border-radius:100px;font-family:var(--head);font-weight:700;font-size:14px;letter-spacing:0;transition:transform .15s ease,background .15s ease}
.kw-meal-cta:hover{transform:translateY(-2px);background:#f0f0f0}
.kw-meal-img{position:relative;background:#000;overflow:hidden;min-height:580px}
.kw-meal-img img{width:100%;height:100%;object-fit:cover;display:block}

