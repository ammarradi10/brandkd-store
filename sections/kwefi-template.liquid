.kw-giftmodal-section:last-child{margin-bottom:0}
.kw-giftmodal-h{font-family:var(--head);font-weight:800;font-size:11.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent);margin-bottom:11px;display:inline-flex;align-items:center;gap:7px}
.kw-giftmodal-h::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.kw-giftmodal-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:start;padding:12px 14px;background:var(--card);border:1px solid var(--card-line);border-radius:10px;margin-bottom:8px}
.kw-giftmodal-row:last-child{margin-bottom:0}
.kw-giftmodal-row .name{font-family:var(--head);font-weight:800;font-size:14px;color:var(--ink);line-height:1.2}
.kw-giftmodal-row .name small{display:block;font-family:var(--sans);font-weight:500;font-size:12px;color:var(--tx);margin-top:4px;line-height:1.45}
.kw-giftmodal-row .dose{font-family:var(--mono);font-weight:700;font-size:12px;color:var(--accent);letter-spacing:0.02em;white-space:nowrap;background:var(--accent-soft);border:1px solid rgba(234,88,12,0.25);border-radius:6px;padding:3px 8px}
.kw-giftmodal-row.no-dose{grid-template-columns:1fr}
.kw-giftmodal-feats{list-style:none;padding:0;margin:0}
.kw-giftmodal-feats li{position:relative;padding-left:28px;font-size:13.5px;color:var(--tx);line-height:1.5;margin-bottom:10px}
.kw-giftmodal-feats li::before{content:"\2713";position:absolute;left:0;top:0;width:18px;height:18px;background:var(--green);color:#fff;font-weight:900;font-size:11px;border-radius:50%;display:flex;align-items:center;justify-content:center}
.kw-giftmodal-feats li strong{color:var(--ink);font-weight:700}
.kw-giftmodal-foot{display:flex;align-items:center;gap:8px;font-family:var(--head);font-weight:800;font-size:11.5px;letter-spacing:0.04em;color:var(--green);padding:12px 14px;background:var(--green-soft);border:1px solid rgba(22,163,74,0.35);border-radius:10px;margin-top:18px;text-transform:uppercase;line-height:1.3}
.kw-giftmodal-foot svg{width:16px;height:16px;flex-shrink:0}

/* Toast + confetti */
.kw-toast{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.7);background:var(--bg);border:2px solid var(--green);border-radius:18px;padding:22px 30px;box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:10000;text-align:center;opacity:0;pointer-events:none;transition:opacity .35s,transform .45s cubic-bezier(.34,1.56,.64,1);max-width:90vw}
.kw-toast.show{opacity:1;transform:translate(-50%,-50%) scale(1)}
.kw-toast-icon{font-size:36px;line-height:1;margin-bottom:8px}
.kw-toast-title{font-family:var(--display);font-weight:400;font-size:24px;color:var(--ink);letter-spacing:0.02em;text-transform:uppercase}
#kwConfetti{position:fixed;inset:0;pointer-events:none;z-index:9999}

/* ====== COMPLETE-MEAL STATS SECTION (dark split) ====== */
.kw-meal{background:#000;color:#fff;overflow:hidden}
.kw-meal-inner{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;min-height:580px;width:100%}
.kw-meal-copy{padding:80px 56px;display:flex;flex-direction:column;justify-content:center}
